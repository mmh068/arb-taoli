# arb-bot 运行配置：复制为 .env 后按需修改。
# 按模块分组；【条件必填】只在启用对应功能时填写，【选填】可使用默认值。
# 仅查看公开行情、扫描机会时，没有必填项。
# 不配置应保留注释或删除该行，不要随意把数值改成空串。
# 私钥、API secret、令牌只放在本机 .env，不要提交或发给任何人。

# ============================================================================
# 一、看板（arb-web）
# ============================================================================

# 【选填】监听地址与端口，默认只允许本机访问。
# 对外暴露前请配置鉴权与 TLS 反向代理。
ARB_BIND_HOST=127.0.0.1
ARB_HTTP_PORT=8080

# 【条件必填】使用看板纸面交易接口或实盘 readonly / trade 时需要令牌。
# 至少 16 个字符；生成示例：openssl rand -hex 24。
# 页面右上角「令牌」填写相同值（只保存在本浏览器）。
# 不配置时看板交易接口关闭，仅可查看公开行情。
# ARB_WEB_TOKEN=

# 【选填】看板实盘：off（默认关闭）/ readonly（连接、对账、出计划）/ trade（真实下单）。
# readonly / trade 需要令牌及交易所凭据；trade 另需下方价格保护。
# 看板与 arb-live 不可同时连接同一批账户（订单意图日志有独占锁）。
# 自动价差下单还需在面板显式开启自动交易，并设置金额、杠杆与规则。
# ARB_WEB_LIVE=off

# 【条件必填】仅 ARB_WEB_LIVE=trade 时必填，readonly 无需填写。
# 平仓 / 回滚 / 减仓价格保护，小数，范围 (0, 0.05]；0.003 = 0.3%。
# ARB_WEB_MARKET_SLIPPAGE=0.003

# 【选填】纸面规则执行间隔（秒），默认 0 = 不自动执行。
# 使用 arb-paper --watch 时，不要让看板同时执行同一纸面台账的规则。
# ARB_WEB_PAPER_WATCH_SEC=0
# 【选填】实盘规则执行间隔（秒），默认跟随 ARB_SCAN_INTERVAL_SEC；0 = 不自动执行。
# ARB_WEB_LIVE_WATCH_SEC=60

# 【选填】策略页最近使用的预检参数文件；网页关闭后仍可在后台继续预检。
# ARB_PRECHECK_STATE=arb-precheck-watches.json
# 【选填】看板实盘台账与订单意图日志目录，默认与 arb-live 相同。
# ARB_LIVE_LEDGER=arb-live-ledger.jsonl
# ARB_LIVE_JOURNAL_DIR=.

# ============================================================================
# 二、交易所（实盘场所、账户类型与凭据）
# ============================================================================
# arb-live 与看板实盘共用凭据；只读连接实盘账户也需要凭据。
# 【条件必填】只需填齐实际连接场所的凭据，不使用实盘则无需填写。
# 双腿套利至少连接两个场所；请用专用账户与专用 API key。
# 中心化交易所的 API Key / Secret 在交易所后台创建，不是钱包地址或私钥；不要开启提现权限。
# 各场所账户前提见 README「实盘执行」。
# arb-live 真实下单还需 CLI 的 --enable-trading 与 --market-slippage。

# 【选填】留空或 auto（默认）按完整凭据自动识别；也可填写逗号分隔列表。
# 例如 hyperliquid,lighter；看板「持仓 → 实盘」页可查看识别结果，不显示密钥。
# ARB_LIVE_VENUES=auto

# ---- Hyperliquid ----
# 【条件必填】主 dex、hyperliquid-xyz、hyperliquid-io 共用以下两项。
# PRIVATE_KEY：优先填已授权的 API Wallet（代理钱包）签名私钥；也支持主账户钱包私钥。
# ACCOUNT_ADDRESS：填实际交易账户的公开地址，不能填 API Wallet 的地址。
# 自动识别会包含主站、xyz、io；各 dex 保证金独立。
# ARB_HL_PRIVATE_KEY=
# ARB_HL_ACCOUNT_ADDRESS=

# ---- Lighter 主网：协议 API 签名密钥 ----
# 【条件必填】以下三项，以及下方共用签名库路径。
# ACCOUNT_INDEX 是 Lighter 交易账户编号；API_KEY_INDEX 是该账户内的 API Key 编号。
# API_PRIVATE_KEY 填对应编号的 Lighter API 签名私钥，不是钱包私钥。
# ARB_LIGHTER_ACCOUNT_INDEX=
# ARB_LIGHTER_API_KEY_INDEX=
# ARB_LIGHTER_API_PRIVATE_KEY=

# ---- Lighter Robinhood Chain：协议 API 签名密钥 ----
# 【条件必填】以下三项，以及下方共用签名库路径。
# 在 Robinhood Chain 部署获取交易账户编号、API Key 编号和对应的 API 签名私钥；不填钱包私钥。
# ARB_LIGHTER_RH_ACCOUNT_INDEX=
# ARB_LIGHTER_RH_API_KEY_INDEX=
# ARB_LIGHTER_RH_API_PRIVATE_KEY=

# 【条件必填】连接任一 Lighter 部署时，填写官方 v1.0.10 签名库路径。
# 下载：https://github.com/elliottech/lighter-go/releases/download/v1.0.10/lighter-signer-linux-amd64.so
# ARB_LIGHTER_SIGNER_LIB=/opt/lighter/lighter-signer-linux-amd64.so

# ---- Binance ----
# 【条件必填】Binance 后台创建的 HMAC API Key + Secret，须支持所选账户的 U 本位合约接口。
# 账户须为单向持仓。
# ARB_BINANCE_API_KEY=
# ARB_BINANCE_API_SECRET=
# 【选填】futures（默认，经典 U 本位合约）/ unified（统一账户，仅全仓）。
# ARB_BINANCE_ACCOUNT=futures

# ---- Bybit ----
# 【条件必填】Bybit 后台创建的系统生成型（HMAC）API Key + Secret，用于 V5 linear 合约。
# ARB_BYBIT_API_KEY=
# ARB_BYBIT_API_SECRET=

# ---- OKX ----
# 【条件必填】OKX 后台创建的 V5 API Key + Secret，用于 SWAP 永续合约。
# PASSPHRASE 是创建该 API Key 时设置的口令，不是交易所登录密码。
# ARB_OKX_API_KEY=
# ARB_OKX_API_SECRET=
# ARB_OKX_PASSPHRASE=

# ---- Bitget ----
# 【条件必填】Bitget 后台创建的 HMAC API Key + Secret，须匹配下方统一或经典合约账户。
# PASSPHRASE 是创建该 API Key 时设置的口令，不是交易所登录密码。
# ARB_BITGET_API_KEY=
# ARB_BITGET_API_SECRET=
# ARB_BITGET_PASSPHRASE=
# 【选填】uta（默认，统一账户）/ classic（经典账户），须与实际账户类型一致。
# ARB_BITGET_ACCOUNT=uta

# ---- Gate ----
# 【条件必填】Gate 后台创建的 V4 API Key + Secret，用于 USDT 合约。
# ARB_GATE_API_KEY=
# ARB_GATE_API_SECRET=

# ---- MEXC ----
# 【条件必填】MEXC 后台创建的合约 API Key + Secret，不是仅有现货权限的 Key。
# ARB_MEXC_API_KEY=
# ARB_MEXC_API_SECRET=

# ---- Aster v3 ----
# 【条件必填】USER 填主钱包公开地址；SIGNER 填已授权的 API 钱包公开地址。
# SIGNER_PRIVATE_KEY 填对应 API 钱包的签名私钥，不是主钱包私钥。
# ARB_ASTER_USER=
# ARB_ASTER_SIGNER=
# ARB_ASTER_SIGNER_PRIVATE_KEY=

# ---- Arcus ----
# 【条件必填】三项均需填写；ACCOUNT_INDEX 必须显式填写，范围 0 ~ 9。
# ADDRESS 填实际交易的主钱包公开地址；ACCOUNT_INDEX 填生成 Key 时选的 Subaccount #。
# API_PRIVATE_KEY 填 app.arcus.xyz/api-keys 生成时只显示一次的 Ed25519 API Signing Key，不是钱包私钥。
# ARB_ARCUS_ADDRESS=
# ARB_ARCUS_ACCOUNT_INDEX=0
# ARB_ARCUS_API_PRIVATE_KEY=

# ============================================================================
# 三、消息推送（TG 和 DC 可独立配置）
# ============================================================================

# --- Telegram（TG）：主动播报与机器人 ---
# 【条件必填】启用 Telegram 时以下两项均需填写；不用则跳过 TG 配置。
# 创建机器人：Telegram 中找 @BotFather → /newbot。
# 给机器人发消息后访问 https://api.telegram.org/bot<TOKEN>/getUpdates 查看 chat.id。
# ARB_ALERT_TELEGRAM_TOKEN=
# ARB_ALERT_TELEGRAM_CHAT=

# 【条件必填】启用命令且 CHAT 是群 / 频道（负数）时，另填管理员用户 ID。
# 私聊 CHAT 默认就是管理员 ID，无需另填；关闭命令时也无需填写。
# 机器人只处理该管理员的私聊消息，忽略其他用户与群消息。
# ARB_TELEGRAM_ADMIN_ID=

# 【选填】配齐机器人凭据后默认开启菜单命令；只要告警时填 off。
# ARB_TELEGRAM_COMMANDS=off
# 【选填】默认允许价差提醒附带两步确认下单按钮；不要按钮时填 off。
# 按钮需要 all 模式、告警发到管理员私聊且命令机器人运行；交易仍受实盘开关与规则约束。
# ARB_TELEGRAM_ORDERS=off

# --- Discord（DC）：Webhook 主动播报 ---
# 【选填】在 Discord 目标频道创建 Webhook 后填写完整 URL；不填则关闭 DC 推送。
# Discord 只发告警正文，不转发 Telegram 命令回复或按钮。URL 含密钥，请勿公开。
# ARB_ALERT_DISCORD_WEBHOOK_URL=

# --- TG / DC 共用播报规则 ---
# 【选填】trades（默认）：仅开仓、补仓、平仓/减仓及执行结果（含失败）。
# all：全部告警，包括风险、服务异常和机会提醒；主动命令回复不受影响。
# 同类消息 30 分钟内只发一次，每分钟最多 6 条；消息不含地址、账户号或密钥。
# ARB_ALERT_MODE=trades

# ============================================================================
# 四、交易风控与持仓上限（以下均为选填）
# ============================================================================

# 单笔最大名义额（USDT），默认 1000；off = 取消名义额上限。
# 取消上限后仍受盘口深度、保证金、强平距离等检查约束。
ARB_MAX_POSITION_USDT=1000
# 单日最大亏损（USDT），默认 100。
ARB_MAX_DAILY_LOSS_USDT=100
# 同时持有的套利仓位上限，账户级、手动与自动合计，默认 5。
# 一笔是一个双腿套利仓位；已有仓位补仓不额外占笔数。
# 范围 1 ~ 10000；off = 不限制持仓笔数。
ARB_MAX_OPEN_POSITIONS=5

# ============================================================================
# 五、行情扫描与收益测算（以下均为选填）
# ============================================================================

# 扫描场所白名单，逗号分隔；不配置或留空表示全部，拼错直接报错。
# lighter-rh 按出口 IP 严格限频：同机实盘使用它时建议从扫描白名单排除，避免抢额度。
# ARB_VENUES=arcus,aster,binance,bitget,bybit,gate,hyperliquid,hyperliquid-io,hyperliquid-xyz,lighter,mexc,okx,ourbit,variational

# 单边吃单费率回落值，默认 0.0005（万 5）；接口有真实费率时优先用真实值。
ARB_FEE_PER_SIDE=0.0005
# 资金费套利计划持有天数，默认 7；一次往返的四笔手续费摊到这些天上。
ARB_AMORTIZE_DAYS=7
# 价差套利计划持有天数，默认 3，影响年化折算。
ARB_SPREAD_HOLD_DAYS=3
# 不利入场基差上限（%），默认 0.5；off = 关闭门槛。
ARB_MAX_ENTRY_BASIS_PCT=0.5
# 两腿各自的计划杠杆，默认 3，范围 1 ~ 100。
# 用于强平距离与保证金年化测算，不影响排名；自动交易杠杆在面板另设。
ARB_LEVERAGE=3
# 一个合约至少需要几家场所才参与配对，默认 2，不能小于 2。
ARB_MIN_VENUES=2
# 后台扫描刷新间隔（秒），默认 60；过短易触发上游 429 限频。
ARB_SCAN_INTERVAL_SEC=60

# ============================================================================
# 六、Hyperliquid 行情与下单方式（以下均为选填，凭据见交易所模块）
# ============================================================================

# 交易盘口来源：bbo（默认，仅买一卖一）/ l2（l2Book 整本 + fast 五档）。
# bbo 顶档需要容纳单腿名义才会出信号；l2 更深，但 l2Book 更新较慢。
# ARB_HL_BOOK=bbo
# WebSocket 下单默认开启，失败或未连接自动回退 HTTP；off = 全部使用 HTTP。
# ARB_HL_WS_ORDERS=on
# 只读影子采样：0（默认关闭）~ 4，主 dex / xyz / io 共用一个连接池。
# 正常交易无需开启；只用于 fast/BBO 延迟对比，不更新交易盘口、不下单。
# 不足订阅预算时自动缩小，不改变 ARB_HL_BOOK 指定的交易行情来源。
# 详情见 notes/MARKET_DATA_LATENCY.md。
# ARB_HL_SHADOW_CONNECTIONS=0

# ============================================================================
# 七、通用运行配置（以下均为选填）
# ============================================================================

# 单个 HTTP 请求超时（秒），默认 15。
ARB_HTTP_TIMEOUT_SEC=15
# 日志过滤，tracing EnvFilter 语法；日志写 stderr，stdout 留给 --json。
ARB_LOG=info
# 收到 SIGINT / SIGTERM 后等待在途操作完成的时限，默认 120 秒，范围 1 ~ 300。
# 不再受理新操作，超时仍退出并告警。pm2 kill_timeout 按本值 + 30 秒计算；
# systemd 用户修改后需同步 deploy/arb-web.service 的 TimeoutStopSec。
# ARB_SHUTDOWN_GRACE_SEC=120
